<?xml version="1.0" encoding="utf-8"?>
<!-- Marco del widget de horario: cabecera (título + letras de día),
     lista de filas L-V y mensaje de estado vacío. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/week_widget_bg"
    android:padding="10dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Horario"
        android:textColor="#2E2418"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <!-- Espaciador que alinea con la columna de horas de las filas. -->
        <TextView
            android:layout_width="26dp"
            android:layout_height="1dp"
            android:text="" />

        <TextView
            android:id="@+id/w_l1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="L"
            android:textColor="#7A6A58"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_l2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="M"
            android:textColor="#7A6A58"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_l3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="X"
            android:textColor="#7A6A58"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_l4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="J"
            android:textColor="#7A6A58"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_l5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="V"
            android:textColor="#7A6A58"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/week_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:listSelector="@android:color/transparent"
        android:paddingTop="2dp"
        android:overScrollMode="never" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Abre Compás UCM para generar tu horario."
        android:textColor="#7A6A58"
        android:textSize="10sp"
        android:visibility="gone" />
</LinearLayout>
